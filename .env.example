# ANTHROPIC_API_KEY: Required for Anthropic Claude AI API calls.
# Set this in your local .env.local file or in Vercel project environment variables.
ANTHROPIC_API_KEY="your-anthropic-api-key-here"

# ANTHROPIC_MODEL: Model to use for AI calls (defaults to claude-3-7-sonnet-20250219).
ANTHROPIC_MODEL="claude-3-7-sonnet-20250219"

# APP_URL: Optional base URL where this app is hosted.
APP_URL="http://localhost:3000"
